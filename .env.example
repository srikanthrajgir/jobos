NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-key"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-5.6-terra"
OPENAI_BASE_URL="https://api.openai.com/v1"
