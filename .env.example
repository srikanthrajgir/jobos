NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-key"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-5.6-terra"
OPENAI_BASE_URL="https://api.openai.com/v1"
RESEND_API_KEY="your-resend-api-key"
APPLICATION_FROM_EMAIL="JobOS Applications <applications@jobos.com.au>"
CRON_SECRET="generate-at-least-32-random-characters"
# Local development only. Production rejects this provider.
AI_PROVIDER="mock"
# Set the same 32-byte base64 value for every production replica.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# Google Maps JavaScript API key for the Employer Map. Restrict it by HTTP
# referrer in Google Cloud Console — it is served to the browser by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"

# Server-side Geocoding API key, used at ingestion to turn suburbs into map
# coordinates. Separate from the browser Maps key above: restrict this one by IP,
# not referrer, since server requests send no referrer. Optional — without it,
# geocoding falls back to the localities already in geocode_cache.
GOOGLE_GEOCODING_API_KEY="your-google-geocoding-server-key"
